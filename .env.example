# ---- API ----
# Server
API_PORT=4000
API_HOST=127.0.0.1
# Public base URL of the API (used to build download/asset URLs)
PUBLIC_API_URL=http://127.0.0.1:4000
# Public base URL of the web app (used for OAuth redirects and CORS)
WEB_ORIGIN=http://127.0.0.1:5173

# Secret used to sign/verify session tokens & misc HMACs. CHANGE THIS.
AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# ---- Database ----
# SQLite file (default, zero setup). A Postgres URL can be swapped in later.
DATABASE_URL=file:./data/ai-arcade.db

# ---- Storage ----
# "local" writes uploads under STORAGE_DIR. "s3" is supported later.
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage

# ---- Auth providers ----
# Leave GitHub creds blank to use the built-in DEV login (local only).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Enable the passwordless dev login button/route (NEVER enable in production).
DEV_LOGIN_ENABLED=true

# Email + password registration/login. Leave on for a public instance.
PASSWORD_AUTH_ENABLED=true

# ---- Email (login codes) ----
# Every password register/login requires a 6-digit code emailed to the user
# as a second factor. Leave SMTP_HOST blank to run without real email — the
# code is printed to the API server console instead (dev/local only; do NOT
# ship this way to real users).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Arcade <noreply@ai-arcade.local>

# Comma-separated list of emails that get the "admin" role automatically.
ADMIN_EMAILS=you@example.com

# Extra allowed CORS origins (comma-separated), or "*" to reflect any origin.
# Needed when the desktop app / web app runs on a different machine than the API.
CORS_ORIGINS=

# ---- Multiplayer relay (lockstep games) ----
MULTIPLAYER_ENABLED=true
# WebSocket path the relay listens on.
MP_PATH=/mp
# Max concurrent lobbies.
MP_MAX_LOBBIES=500
# Public ws://|wss:// URL games should connect to. Blank = derive from PUBLIC_API_URL.
PUBLIC_WS_URL=

# ---- Upload limits ----
# Max uploaded bundle size in bytes (default 50 MB)
MAX_BUNDLE_BYTES=52428800
# Max total uncompressed size in bytes (default 200 MB) — zip-bomb guard
MAX_UNZIPPED_BYTES=209715200
# Max number of files in a bundle
MAX_BUNDLE_FILES=2000

# ---- Web (Vite) ----
VITE_API_URL=http://127.0.0.1:4000
