# ---- AI Arcade — production ----
# Copy to `.env` on the server and fill in. Everything else has a sane default.

# The domain you pointed at this server. Used by Caddy for HTTPS and must match
# the PUBLIC_* URLs below.
DOMAIN=games.example.com

NODE_ENV=production

# Long random secret that signs session tokens & OAuth state. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=CHANGE_ME_to_a_long_random_string

# Emails that automatically become admins (comma-separated).
ADMIN_EMAILS=you@example.com

# Who may create an account (comma-separated). Leave empty only if signup is meant to be
# open to anyone — uploaded games are served from this domain before moderation.
SIGNUP_ALLOWED_EMAILS=friend@example.com

# Public URLs — must be https/wss and match DOMAIN.
PUBLIC_API_URL=https://games.example.com
PUBLIC_WS_URL=wss://games.example.com/mp

# Accounts: keep password auth on; turn dev-login OFF for a public server.
PASSWORD_AUTH_ENABLED=true
DEV_LOGIN_ENABLED=false

# Email (login codes) — REQUIRED for anyone to actually sign in with a
# password on a public server. Every register/login emails a 6-digit code as
# a second factor; without SMTP configured, that code only ever reaches the
# server's console log, which real users can't see. Use a real provider
# (e.g. Amazon SES, Postmark, SendGrid, Mailgun, or your own mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Arcade <noreply@games.example.com>

# The desktop app / web app run on other origins, so reflect any origin.
# Cross-origin writes still need a bearer token or the CSRF header, so this is safe.
CORS_ORIGINS=*

# Optional GitHub OAuth (leave blank to disable). Callback:
#   https://games.example.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Upload limits (defaults shown)
MAX_BUNDLE_BYTES=52428800
MAX_UNZIPPED_BYTES=209715200
MAX_BUNDLE_FILES=2000

# Multiplayer relay
MULTIPLAYER_ENABLED=true
MP_PATH=/mp
MP_MAX_LOBBIES=500

# Data lives on the mounted volume; you normally don't change these.
DATABASE_URL=file:/data/ai-arcade.db
STORAGE_DIR=/data/storage
