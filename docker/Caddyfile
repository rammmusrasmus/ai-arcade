# Terminates HTTPS for AI Arcade. The exact path "/" is the download page for the
# desktop app; everything else (API, /mp WebSocket relay) goes to the app container.

{$DOMAIN} {
	encode zstd gzip

	# large uploads: game bundles up to 50 MB (+ headroom)
	request_body {
		max_size 80MB
	}

	handle / {
		root * /srv/site
		rewrite * /index.html
		file_server
	}

	handle {
		reverse_proxy app:4000 {
			# don't buffer the relay / downloads
			flush_interval -1
		}
	}
}
